groups=(qt6)
_pkgfn=${pkgbase/6-/}
source=(https://download.qt.io/archive/qt/6.12/6.12.0/single/qt-everywhere-src-6.12.0.tar.xz
        qt6-base-cflags.patch
        qt6-base-nostrip.patch)
sha256sums=('SKIP'
            '5411edbe215c24b30448fac69bd0ba7c882f545e8cf05027b2b6e2227abc5e78'
