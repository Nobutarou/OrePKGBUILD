prepare() {
  set -x
  # src/qt-everywhere-src-6.12.0/ が出きる
  mv qt-everywhere-src-$_pkgver $_pkgfn
  
#  patch -d qt-everywhere-src-$_pkgver -p1 < qt6-base-cflags.patch # Use system CFLAGS
#  patch -d qt-everywhere-src-$_pkgver -p1 < qt6-base-nostrip.patch # Don't strip binaries with qmake
#
#  git -C $_pkgfn cherry-pick -n e320c929207aaea0d4c8fb2cd29b16de6cbd2b2c # Fix QtWebEngine detection in cmake
#  git -C $_pkgfn cherry-pick -n 032643f99e090e0304ef935c2ee11c109d55c8a1 # Fix build with md4c 0.6
}

build() {
  set -x
  # Set no_direct_extern_access based on architecture
  if [[ $CARCH == "aarch64" || $CARCH == "riscv64" ]]; then
    _no_direct_extern_access=OFF
  else
    _no_direct_extern_access=ON
  fi

  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DINSTALL_BINDIR=lib/qt6/bin \
    -DINSTALL_PUBLICBINDIR=bin \
    -DINSTALL_LIBEXECDIR=lib/qt6 \
    -DINSTALL_DOCDIR=share/doc/qt6 \
    -DINSTALL_ARCHDATADIR=lib/qt6 \
    -DINSTALL_DATADIR=share/qt6 \
    -DINSTALL_INCLUDEDIR=include/qt6 \
    -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
    -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples \
    -DFEATURE_journald=ON \
    -DFEATURE_libproxy=ON \
    -DFEATURE_openssl_linked=ON \
    -DFEATURE_system_sqlite=ON \
    -DFEATURE_system_xcb_xinput=ON \
    -DFEATURE_no_direct_extern_access=$_no_direct_extern_access \
    -DFEATURE_mimetype_database=OFF \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
    -DFEATURE_cups=OFF \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DBUILD_qtsvg=ON
  cmake --build build
}

package_qt6-base() {
  pkgdesc='A cross-platform application and UI framework'
  conflicts=(
    qt6-5compat
    qt6-declarative
    qt6-shadertools
    qt6-svg
    qt6-tools
    qt6-translations
  )
  replaces=(
    qt6-5compat
    qt6-declarative
    qt6-shadertools
    qt6-svg
    qt6-tools
    qt6-translations
  )
  provides=(
    qt6-5compat
    qt6-declarative
    qt6-shadertools
    qt6-svg
    qt6-tools
    qt6-translations
  )
  depends+=(qt6-translations)
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 $_pkgfn/LICENSES/* -t "$pkgdir"/usr/share/licenses/$pkgbase
}

package_qt6-xcb-private-headers() {
  set -x
  pkgdesc='Private headers for Qt6 Xcb'

  depends=("qt6-base=$pkgver")
  optdepends=()
  groups=()

  cd $_pkgfn
  install -d -m755 "$pkgdir"/usr/include/qt6xcb-private/gl_integrations
  cp -r qtbase/src/plugins/platforms/xcb/*.h "$pkgdir"/usr/include/qt6xcb-private/
  cp -r qtbase/src/plugins/platforms/xcb/gl_integrations/*.h "$pkgdir"/usr/include/qt6xcb-private/gl_integrations/
}
