prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

exec_prefix=${prefix}
datadir=${prefix}/share
datarootdir=${prefix}/share
interfaces_dir=${datadir}/dbus-1/interfaces/

Name: flatpak
Description: Application sandboxing framework
Version: 1.18.4
Requires: glib-2.0 >= 2.46, gio-2.0, ostree-1 >= 2020.8
Requires.private: gio-unix-2.0, dconf >= 0.26, gpgme >= 1.8.0, json-glib-1.0, libarchive >= 2.8.0, libcurl >= 7.29.0, libseccomp, libsystemd, libxml-2.0 >= 2.4, libzstd >= 0.8.1, polkit-agent-1 >= 0.98, xau, wayland-client
Libs: -L${libdir} -lflatpak
Cflags: -I${includedir}/flatpak
