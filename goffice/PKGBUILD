# OreMod
# - kill libspectre

pkgname=goffice
pkgver=1000.0.0
_pkgver=0.10.62
pkgrel=1
pkgdesc='A GLib/GTK set of document-centric objects and utilities library'
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/goffice'
license=('GPL-2.0-only OR GPL-3.0-only')
depends=(
  at-spi2-core
  cairo
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  lasem
  libgsf
  librsvg
  libxml2
  libxslt
  pango
)
makedepends=(
  git
  glib2-devel
  intltool
)
source=("https://download.gnome.org/sources/goffice/0.10/goffice-$_pkgver.tar.xz")
b2sums=('SKIP')

prepare() {
  :
}

build() {
  set -x
  cd $pkgname-$_pkgver
  export CFLAGC="-O2"
  export CXXFLAGC="-O2"
  ./configure --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-introspection 
  #./configure \
  #  --prefix=/usr \
  #  --sysconfdir=/etc \
  #  --localstatedir=/var \
  #  --disable-introspection 
  #sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd $pkgname-$_pkgver
  make check
}

package() {
  cd $pkgname-$_pkgver
  make DESTDIR="$pkgdir" install
}
