# kill avahi
# ついで
# - jack2
# もとの PKGBUILD を使おうと思ったが、あまりに汚ないのであきらめて BLFS のビルドそのままに
# した。
provides=(
  'pipewire=1:1.6.9-1'
  'libpipewire-0.3.so=0-64'
  'libpipewire=1:1.6.9-1' 
)
pkgbase=pipewire
pkgname=pipewire

pkgver=100.0.0
_true_pkgver=1.6.9
pkgrel=1
epoch=1
pkgdesc="Low-latency audio/video router and processor"
url="https://pipewire.org"
arch=(x86_64)
license=(MIT)
makedepends=(
)
depends=(
  'bluez-libs'
)
source=(
  "https://gitlab.freedesktop.org/pipewire/pipewire/-/archive/1.6.9/pipewire-1.6.9.tar.bz2"
)
b2sums=('SKIP')

conflicts=(
  'alsa-card-profiles'
  'libpipewire'
  'pipewire-audio'
  'pipewire-pulse'
  'libpipewire'
)
replaces=(
  'alsa-card-profiles'
  'libpipewire'
  'pipewire-audio'
  'pipewire-pulse'
  'libpipewire'
)
provides=(
  "gstreamer=$pkgver"
  "gst-plugins-bad-libs=$pkgver"
  "gst-plugins-base-libs=$pkgver"
  "gst-plugins-base=$pkgver"
  "gst-plugins-good=$pkgver"
  "gst-plugins-bad=$pkgver"
  "gst-plugins-ugly=$pkgver"
)

prepare() {
  :
}

build() {
  set -x
#  local meson_options=(
#    -D jack-devel=false
#    -D session-managers=[]
#    -D selinux=disabled 
#    -D libffado=disabled
#    -D avahi=disabled
#  )

  CFLAGS="-O2"
  CXXFLAGS="-O2"

  cd "$srcdir/$pkgname-$_true_pkgver"
  mkdir -v build
  cd build
  meson setup .. \
    --prefix=/usr \
    --buildtype=release \
    -D session-managers="[]"\
    -D jack-devel=false \
    -D avahi=disabled
  ninja -j10 -v
}

package() {
  cd "$srcdir/$pkgname-$_true_pkgver"
  DESTDIR="$pkgdir" meson install -C build
}

